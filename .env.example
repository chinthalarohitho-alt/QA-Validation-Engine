# Copy to .env. Every value has a working default for the public demo targets, so a
# fresh clone runs with no .env at all — these exist to show where real secrets would go.

# Which environment block in shared/config/env.config.ts to use.
TEST_ENV=demo

# SauceDemo — the web UI target. All personas share this password.
SAUCE_PASSWORD=secret_sauce

# DummyJSON — the API target.
API_USERNAME=emilys
API_PASSWORD=emilyspass

# QuickPizza — the k6 target. Its public demo token.
K6_API_TOKEN=abcdef0123456789

# Retries for the web lane (the API lane never retries).
# PW_RETRIES=1

# Optional: post a run summary to Slack from CI.
# SLACK_WEBHOOK_URL=
