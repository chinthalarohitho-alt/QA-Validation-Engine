{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", ".features-gen", "shared/k6/**", "projects/**/k6/**"]
}
